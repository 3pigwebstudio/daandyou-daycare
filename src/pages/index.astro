---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandIntro from '../components/BrandIntro.astro';
import DesktopLanding from '../components/DesktopLanding.astro';
import MobileApp from '../components/MobileApp.astro';
import ProgramGallery from '../components/ProgramGallery.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteScripts from '../components/SiteScripts.astro';
---

<BaseLayout>
  <div class="site-shell" id="site-shell">
    <SiteHeader />
    <main id="main-content">
      <MobileApp />
      <DesktopLanding />
    </main>
    <SiteFooter />
    <ProgramGallery />
    <SiteScripts />
  </div>
  <BrandIntro />
</BaseLayout>
