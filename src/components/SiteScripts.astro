<script is:inline>
  (() => {
    const logo = document.getElementById('official-logo');
    const fallback = document.getElementById('logo-fallback');
    if (logo instanceof HTMLImageElement && fallback instanceof HTMLElement) {
      const showFallback = () => { logo.hidden = true; fallback.hidden = false; };
      logo.addEventListener('error', showFallback, { once: true });
      if (logo.complete && logo.naturalWidth === 0) showFallback();
    }

    const header = document.querySelector('.site-header');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 14);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    document.addEventListener('click', (event) => {
      const source = event.target instanceof Element ? event.target.closest('[data-analytics-event]') : null;
      if (!(source instanceof HTMLElement)) return;
      const eventName = source.dataset.analyticsEvent;
      if (!eventName) return;
      const detail = {
        event: eventName,
        event_label: source.dataset.analyticsLabel || source.textContent?.trim() || '',
        link_url: source instanceof HTMLAnchorElement ? source.href : '',
      };
      if (Array.isArray(window.dataLayer)) window.dataLayer.push(detail);
      if (typeof window.gtag === 'function') window.gtag('event', eventName, detail);
      window.dispatchEvent(new CustomEvent('dnucare:conversion', { detail }));
    });

    if ('IntersectionObserver' in window && Element.prototype.animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const targets = document.querySelectorAll('.intro-grid,.team-grid,.section-head,.day-head,.guide-intro,.program-bento-lead,.program-bento-card,.day-item,.contact-inner');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          entry.target.animate([{ opacity: 0.86, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -30px 0px' });
      targets.forEach((target) => observer.observe(target));
    }

    const gallery = document.getElementById('program-gallery');
    if (gallery instanceof HTMLDialogElement) {
      const panels = Array.from(gallery.querySelectorAll('[data-gallery-panel]'));
      let activePanel = null;
      let activePhoto = 0;

      const renderGalleryPhoto = (requestedIndex) => {
        if (!(activePanel instanceof HTMLElement)) return;
        const thumbs = Array.from(activePanel.querySelectorAll('[data-gallery-thumb]'));
        if (!thumbs.length) return;
        activePhoto = (requestedIndex + thumbs.length) % thumbs.length;
        const selected = thumbs[activePhoto];
        const image = activePanel.querySelector('[data-gallery-image]');
        const caption = activePanel.querySelector('[data-gallery-caption]');
        const current = activePanel.querySelector('[data-gallery-current]');
        if (image instanceof HTMLImageElement && selected instanceof HTMLElement) {
          image.src = selected.dataset.gallerySrc || '';
          image.alt = selected.dataset.galleryAlt || '';
        }
        if (caption) caption.textContent = selected instanceof HTMLElement ? selected.dataset.galleryCaption || '' : '';
        if (current) current.textContent = String(activePhoto + 1).padStart(2, '0');
        thumbs.forEach((thumb, index) => {
          thumb.classList.toggle('is-active', index === activePhoto);
          thumb.setAttribute('aria-pressed', index === activePhoto ? 'true' : 'false');
        });
        selected?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      };

      const openGallery = (programIndex) => {
        activePanel = panels.find((panel) => panel instanceof HTMLElement && Number(panel.dataset.galleryPanel) === programIndex) || panels[0] || null;
        panels.forEach((panel) => { panel.hidden = panel !== activePanel; });
        renderGalleryPhoto(0);
        document.documentElement.classList.add('gallery-open');
        gallery.showModal();
        gallery.querySelector('[data-gallery-close]')?.focus();
        window.dispatchEvent(new CustomEvent('dnucare:conversion', { detail: { event: 'program_gallery_open', event_label: activePanel instanceof HTMLElement ? activePanel.querySelector('h2')?.textContent?.trim() || '' : '' } }));
      };

      document.querySelectorAll('[data-gallery-program]').forEach((card) => {
        const activate = () => openGallery(Number(card.dataset.galleryProgram || 0));
        card.addEventListener('click', activate);
        card.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          activate();
        });
      });
      gallery.querySelector('[data-gallery-close]')?.addEventListener('click', () => gallery.close());
      gallery.addEventListener('click', (event) => { if (event.target === gallery) gallery.close(); });
      gallery.addEventListener('close', () => document.documentElement.classList.remove('gallery-open'));
      gallery.addEventListener('click', (event) => {
        const thumb = event.target instanceof Element ? event.target.closest('[data-gallery-thumb]') : null;
        if (thumb instanceof HTMLElement) renderGalleryPhoto(Number(thumb.dataset.galleryThumb || 0));
        if (event.target instanceof Element && event.target.closest('[data-gallery-prev]')) renderGalleryPhoto(activePhoto - 1);
        if (event.target instanceof Element && event.target.closest('[data-gallery-next]')) renderGalleryPhoto(activePhoto + 1);
      });
      gallery.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); renderGalleryPhoto(activePhoto - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); renderGalleryPhoto(activePhoto + 1); }
      });
    }

    const app = document.getElementById('xi-mobile-app');
    if (!app) return;
    const views = Array.from(app.querySelectorAll('[data-view]'));
    const validViews = ['home', 'about', 'programs', 'visit'];
    const setView = (requestedView, updateHistory = true) => {
      const view = validViews.includes(requestedView) ? requestedView : 'home';
      views.forEach((item) => { item.hidden = item.dataset.view !== view; });
      app.dataset.current = view;
      if (updateHistory) history.pushState({ xi: view }, '', view === 'home' ? '#mobile-home' : `#mobile-${view}`);
      // Desktop hash navigation must retain its native anchor position.
      if (window.matchMedia('(max-width: 850px)').matches) {
        window.scrollTo({ top: 0, behavior: 'instant' });
      }
    };
    app.querySelectorAll('[data-xi-target]').forEach((control) => control.addEventListener('click', (event) => {
      event.preventDefault();
      setView(control.dataset.xiTarget || 'home');
    }));
    document.querySelector('.site-header .brand')?.addEventListener('click', (event) => {
      if (window.matchMedia('(max-width: 850px)').matches) { event.preventDefault(); setView('home'); }
    });
    // Support shared desktop section URLs on the separate mobile app.
    // Keep the original hash so the same URL works on both layouts.
    const viewFromHash = () => {
      const hash = location.hash;
      const sharedSectionViews = {
        '#why': 'about',
        '#people': 'about',
        '#care': 'programs',
        '#guide': 'visit',
        '#contact': 'visit',
      };
      return sharedSectionViews[hash] || (hash.startsWith('#mobile-') ? hash.slice('#mobile-'.length) : 'home');
    };
    const syncViewFromHash = () => setView(viewFromHash(), false);
    window.addEventListener('popstate', syncViewFromHash);
    window.addEventListener('hashchange', syncViewFromHash);
    syncViewFromHash();

    const track = document.getElementById('xi-card-track');
    if (!track) return;
    const cards = Array.from(track.children);
    const current = document.getElementById('xi-card-current');
    const dots = Array.from(app.querySelectorAll('.xi-dots button'));
    const previous = document.getElementById('xi-prev');
    const next = document.getElementById('xi-next');
    let active = 0;
    const render = (requestedIndex) => {
      active = Math.max(0, Math.min(cards.length - 1, requestedIndex));
      if (current) current.textContent = String(active + 1).padStart(2, '0');
      dots.forEach((dot, index) => { dot.classList.toggle('is-active', index === active); index === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'); });
      if (previous) previous.disabled = active === 0;
      if (next) next.disabled = active === cards.length - 1;
    };
    const scrollCard = (requestedIndex) => {
      const index = Math.max(0, Math.min(cards.length - 1, requestedIndex));
      const firstCard = cards[0];
      const card = cards[index];
      if (!firstCard || !card) return;
      track.scrollTo({ left: card.offsetLeft - firstCard.offsetLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      render(index);
    };
    dots.forEach((dot, index) => dot.addEventListener('click', () => scrollCard(index)));
    previous?.addEventListener('click', () => scrollCard(active - 1));
    next?.addEventListener('click', () => scrollCard(active + 1));
    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const firstCard = cards[0];
        if (!firstCard) return;
        let nearest = 0;
        let distance = Infinity;
        cards.forEach((card, index) => { const nextDistance = Math.abs((card.offsetLeft - firstCard.offsetLeft) - track.scrollLeft); if (nextDistance < distance) { distance = nextDistance; nearest = index; } });
        render(nearest);
        ticking = false;
      });
    }, { passive: true });
    track.addEventListener('keydown', (event) => { if (event.key === 'ArrowRight') { event.preventDefault(); scrollCard(active + 1); } if (event.key === 'ArrowLeft') { event.preventDefault(); scrollCard(active - 1); } });
    render(0);
  })();
</script>
