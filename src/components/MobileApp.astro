---
import PhoneLink from './PhoneLink.astro';
import { center, contact, dailyMoments, faqs, media, programs, team, trustFacts } from '../data/site';

const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(center.address)}`;
---

<div class="xi-mobile-app" id="xi-mobile-app">
  <section aria-label="모바일 바로가기" class="xi-view xi-home" data-view="home">
    <nav aria-label="세 가지 주요 정보" class="xi-portal">
      <a class="xi-tile xi-tile-a" data-xi-target="about" href="#mobile-about"><span class="xi-tile-index">01 / 다앤유 소개</span><span aria-hidden="true" class="xi-tile-arrow">↗</span><strong>다앤유 소개</strong><span class="xi-tile-copy">안심되는 돌봄</span></a>
      <a class="xi-tile xi-tile-b" data-xi-target="programs" href="#mobile-programs"><span class="xi-tile-index">02 / 프로그램</span><span aria-hidden="true" class="xi-tile-arrow">↗</span><strong>전문 프로그램</strong><span class="xi-tile-copy">몸과 마음을 살피는 활동</span></a>
      <a class="xi-tile xi-tile-c" data-xi-target="visit" href="#mobile-visit"><span class="xi-tile-index">03 / 이용 안내</span><span aria-hidden="true" class="xi-tile-arrow">↗</span><strong>이용 및 위치 안내</strong><span class="xi-tile-copy">처음부터 친절하게</span></a>
    </nav>
    <p class="xi-footnote">부모님의 편안한 하루를 다앤유가 함께합니다.</p>
  </section>

  <section aria-labelledby="xi-about-title" class="xi-view xi-detail" data-view="about" hidden>
    <button aria-label="메인 메뉴로 돌아가기" class="xi-back" data-xi-target="home" type="button">〈 <span>메인으로</span></button>
    <div class="xi-detail-head"><p class="xi-overline">ABOUT · DA&amp;YOU</p><h2 id="xi-about-title">가족은 안심하고,<br /><em>부모님은 편안하게.</em></h2><p>오랜 장기요양 현장 경험과 재활 전문성을 바탕으로 부모님의 몸과 마음, 일상을 세심하게 살핍니다.</p></div>
    <figure class="xi-photo"><img alt={media.signage.alt} src={media.signage.src} /></figure>
    <div class="xi-facts">
      {trustFacts.map((fact) => <article><b>{fact.index}</b><span><strong>{fact.title}</strong><small>{fact.description}</small></span></article>)}
    </div>
    <section aria-labelledby="xi-expertise-title" class="xi-expertise">
      <p class="xi-overline">EXPERTISE &amp; EXPERIENCE</p>
      <h3 id="xi-expertise-title">경험 있는 전문가가 함께합니다.</h3>
      <div class="xi-expertise-list">{team.map((member) => <p><strong>{member.role}</strong><span>{member.expertise}</span></p>)}</div>
    </section>
    <a class="xi-inline-cta" data-xi-target="programs" href="#mobile-programs">전문 프로그램 살펴보기 <span>→</span></a>
  </section>

  <section aria-labelledby="xi-program-title" class="xi-view xi-detail xi-program-view" data-view="programs" hidden>
    <button aria-label="메인 메뉴로 돌아가기" class="xi-back" data-xi-target="home" type="button">〈 <span>메인으로</span></button>
    <div class="xi-detail-head"><p class="xi-overline">OUR PROGRAM</p><h2 id="xi-program-title">몸과 마음을 살피는<br /><em>다앤유의 하루.</em></h2><p>식사와 움직임부터 인지·일상 활동까지, 부모님께 필요한 도움을 살펴보세요.</p></div>
    <div aria-label="프로그램 카드 슬라이더" class="xi-carousel-wrap">
      <div aria-label="프로그램 소개 카드. 좌우로 넘기거나 이전·다음 버튼을 누르세요." class="xi-card-track" id="xi-card-track" tabindex="0">
        {programs.map((program, index) => (
          <article aria-label={`${index + 1}번째 프로그램: ${program.title}`} class="xi-program-card">
            {program.image ? (
              <div class="xi-program-photo"><img alt={program.image.alt} src={program.image.src} /></div>
            ) : (
              <div class="xi-program-photo xi-pattern"><div aria-hidden="true" class="xi-shape-grid"><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="xi-photo-note">활동 영역 개념 이미지</span></div>
            )}
            <div class="xi-program-body"><small>{program.index} / {program.overline}</small><h3>{program.title}</h3><p>{program.description}</p><span class="xi-topic">{program.topic}</span></div>
          </article>
        ))}
      </div>
    </div>
    <div class="xi-slider-controls">
      <span aria-live="polite" class="xi-counter"><strong id="xi-card-current">01</strong> / {String(programs.length).padStart(2, '0')}</span>
      <div aria-label="프로그램 순서" class="xi-dots">
        {programs.map((program, index) => <button aria-current={index === 0 ? 'true' : undefined} aria-label={`${program.title} 보기`} class={index === 0 ? 'is-active' : ''} data-card-index={index}></button>)}
      </div>
      <div class="xi-slider-arrows"><button id="xi-prev" type="button"><span aria-hidden="true">←</span> 이전</button><button id="xi-next" type="button">다음 <span aria-hidden="true">→</span></button></div>
    </div>
    <p class="xi-program-note">어르신마다 필요한 도움이 다르므로, 상담을 통해 부모님께 맞는 활동을 함께 찾아드립니다.</p>
    <section aria-labelledby="xi-day-title" class="xi-mobile-day">
      <p class="xi-overline">A DAY WITH DA&amp;YOU</p>
      <h3 id="xi-day-title">어르신의 속도에 맞춰 하루를 함께합니다.</h3>
      <div>{dailyMoments.map((moment) => <article><small>{moment.index} / {moment.label}</small><strong>{moment.title.replace('\n', ' ')}</strong><p>{moment.description}</p></article>)}</div>
    </section>
  </section>

  <section aria-labelledby="xi-visit-title" class="xi-view xi-detail" data-view="visit" hidden>
    <button aria-label="메인 메뉴로 돌아가기" class="xi-back" data-xi-target="home" type="button">〈 <span>메인으로</span></button>
    <div class="xi-detail-head"><p class="xi-overline">VISIT &amp; CONTACT</p><h2 id="xi-visit-title">무엇부터 물어볼지<br /><em>몰라도 괜찮습니다.</em></h2><p>부모님의 상황을 편하게 말씀해 주세요. 이용 절차부터 차근차근 안내해 드립니다.</p></div>
    <div class="xi-visit-block"><span>이용 문의</span><strong>{contact.displayPhone}</strong><p>추가 문의 {contact.secondaryDisplayPhone}</p><p>{center.hours}</p><PhoneLink class="xi-inline-cta" label="이용 상담하기"><span>→</span></PhoneLink></div>
    <section aria-labelledby="xi-faq-title" class="xi-faq-group">
      <h3 id="xi-faq-title">이용 전 자주 묻는 질문</h3>
      {faqs.map((faq) => <details class="xi-faq"><summary>{faq.question}<span aria-hidden="true">＋</span></summary><p>{faq.answer}</p></details>)}
    </section>
    <a class="xi-map-placeholder" data-analytics-event="directions_click" data-analytics-label="mobile_visit" href={directionsUrl} rel="noopener noreferrer" target="_blank"><span aria-hidden="true">⌖</span><strong>센터 위치·길찾기</strong><p>{center.address} · {center.postalCode}</p><small>Google 지도에서 열기 ↗</small></a>
  </section>
</div>
